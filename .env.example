# URL publique definitive, sans slash final. Local par defaut.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# unavailable (defaut), resend, mock (developpement uniquement)
CONTACT_TRANSPORT=unavailable
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Production : stockage Redis REST partage pour la limitation de debit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
# Gestion du site : SQLite dans .data/ en local, PostgreSQL obligatoire sur Vercel.
# URL fournie par votre base PostgreSQL avec TLS. Secret, jamais NEXT_PUBLIC_.
DATABASE_URL=
# Dossier local persistant (facultatif, par defaut .data/ dans le projet).
CMS_DATA_DIR=
# Code aleatoire de 32 caracteres minimum pour creer le premier compte.
# Local : genere automatiquement dans .data/admin-setup-token.txt si absent.
# Vercel : definir explicitement un code fort avant la premiere connexion.
ADMIN_SETUP_TOKEN=
# L'indexation se regle maintenant dans Administration > Coordonnees et reglages.
